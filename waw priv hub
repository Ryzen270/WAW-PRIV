-- ============================================
-- 🧠 FUNCIONES
-- ============================================
local function getChar()
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getChar()
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

-- ============================================
-- 🔒 CONGELAR (ANCHOR + BLOQUEAR SALTOS)
-- ============================================
local function freeze()
    local char = getChar()
    if not char then return end

    local humanoid = getHumanoid()
    if not humanoid then return end

    -- Guardar valores originales
    savedJumpPower = humanoid.JumpPower
    savedJumpHeight = humanoid.JumpHeight
    savedUseJumpPower = humanoid.UseJumpPower

    -- 1️⃣ Anclar todas las partes
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
        end
    end

    -- 2️⃣ Bloquear saltos (doble seguridad)
    humanoid.UseJumpPower = true
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0

    -- 3️⃣ Neutralizar cualquier JumpRequest
    local conn
    conn = UserInputService.JumpRequest:Connect(function()
        if anchored and humanoid then
            humanoid.JumpPower = 0
            humanoid.JumpHeight = 0
        end
    end)
    -- Guardar conexión para desconectar al desactivar
    heartbeatConn = conn

    anchored = true
end

-- ============================================
-- 🔓 DESCONGELAR
-- ============================================
local function unfreeze()
    local char = getChar()
    if not char then return end

    local humanoid = getHumanoid()
    if not humanoid then return end

    -- 1️⃣ Desanclar
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
        end
    end

    -- 2️⃣ Restaurar saltos
    humanoid.UseJumpPower = savedUseJumpPower
    humanoid.JumpPower = savedJumpPower
    humanoid.JumpHeight = savedJumpHeight

    -- 3️⃣ Desconectar el bloqueador de JumpRequest
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end

    anchored = false
end

-- ============================================
-- 🛡️ BUCLE DE PROTECCIÓN
-- ============================================
-- Si algún script externo intenta cambiar JumpPower, lo forzamos a 0
RunService.Heartbeat:Connect(function()
    if not anchored then return end

    local humanoid = getHumanoid()
    if not humanoid then return end

    if humanoid.JumpPower ~= 0 then
        humanoid.JumpPower = 0
    end
    if humanoid.JumpHeight ~= 0 then
        humanoid.JumpHeight = 0
    end
end)

-- ============================================
-- 🔄 ACTUALIZAR UI
-- ============================================
local function updateUI()
    if anchored then
        ToggleBtn.Text = "DESANCLAR"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        StatusLabel.Text = "Estado: 🔴 Anclado"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    else
        ToggleBtn.Text = "ANCLAR"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
        StatusLabel.Text = "Estado: 🟢 Libre"
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
end

-- ============================================
-- 🔘 BOTÓN TOGGLE
-- ============================================
ToggleBtn.MouseButton1Click:Connect(function()
    if anchored then
        unfreeze()
    else
        freeze()
    end
    updateUI()
end)

-- ============================================
-- ⌨️ ATAJO DE TECLADO (T)
-- ============================================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then
        if anchored then
            unfreeze()
        else
            freeze()
        end
        updateUI()
    end
end)

